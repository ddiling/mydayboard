<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint runs with warningsAsErrors = true (see build-logic AndroidLint.kt),
  so every warning below already fails the build, including the Compose lint
  checks (ComposableNaming, ModifierParameter, ...) shipped with Compose.
  Disable a check here only with a reason; prefer lint-baseline.xml for legacy code.
-->
<lint>
    <!-- Dependency freshness is Dependabot's job. These would fail the build whenever
         a newer library is published, which breaks reproducible builds. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />

    <!-- Lint checks bundled in third-party AARs compiled against older lint APIs. -->
    <issue id="ObsoleteLintCustomCheck" severity="ignore" />

    <!-- Make intent explicit for checks that matter most. -->
    <issue id="HardcodedText" severity="error" />
    <issue id="UnusedResources" severity="error" />
    <issue id="MissingTranslation" severity="error" />
    <issue id="NewApi" severity="error" />
</lint>
