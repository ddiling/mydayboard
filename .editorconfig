# Read by ktlint (via Spotless), Android Studio and most editors.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Wildcard imports hide where symbols come from.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Previews and Compose code often exceed the default expression-wrapping heuristics.
ktlint_standard_function-expression-body = disabled

[**/build/**]
ktlint = disabled
